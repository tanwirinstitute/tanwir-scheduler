{
  "name": "tanwir-scheduler",
  "version": "1.0.0",
  "description": "A lightweight Node.js scheduler using Express and node-cron for Render.com deployment.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "presync": "npm run build",
    "sync": "node dist/scripts/runSync.js",
    "lint": "eslint .",
    "test": "echo \"No tests specified yet.\" && exit 0"
  },
  "keywords": [
    "scheduler",
    "node",
    "cron",
    "render",
    "express",
    "node-cron"
  ],
  "author": "Yassine Elmellouki <yelmellouki@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "eslint": "^8.57.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
